# Copy to .env and adjust. Loaded by Docker Compose and read by tooling.

# Postgres (deploy/compose/postgres.yml)
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena
POSTGRES_PORT=5432

# Connection URL used by Alembic and the application. Note the psycopg (v3)
# driver: postgresql+psycopg, not postgresql+psycopg2.
DATABASE_URL=postgresql+psycopg://arena:arena@localhost:5432/arena
