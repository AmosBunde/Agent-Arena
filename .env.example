# Copy to .env and adjust. Loaded by Docker Compose and read by tooling.

# Provider API keys. At least one is needed to execute runs against a
# commercial API; local models through Ollama need none. Keys reach only the
# runner service (system-design.md, Security).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Local model settings (ADR-0004: local compute cost, defaults to zero).
#OLLAMA_BASE_URL=http://host.docker.internal:11434
#LOCAL_HOURLY_RATE_USD=0

# Postgres (deploy/compose/docker-compose.yml and deploy/compose/postgres.yml)
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena
POSTGRES_PORT=5432

# Connection URL used by Alembic and local tooling running outside Compose.
# Note the psycopg (v3) driver: postgresql+psycopg, not postgresql+psycopg2.
DATABASE_URL=postgresql+psycopg://arena:arena@localhost:5432/arena
